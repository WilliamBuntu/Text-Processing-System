<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.textprocessingsystem.controller.BatchProcessingController"
      spacing="10">
    <padding>
        <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
    </padding>

    <Label text="Batch Text Processing" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>

    <HBox spacing="10">
        <Button fx:id="addFilesButton" text="Add Files" onAction="#handleAddFiles" />
    </HBox>

    <Label text="Selected Files:"/>
    <ListView fx:id="fileListView" prefHeight="120.0"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Regex Pattern:" />
        <TextField fx:id="regexField" promptText="Enter regex pattern" HBox.hgrow="ALWAYS"/>
    </HBox>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Replacement:" />
        <TextField fx:id="replacementField" promptText="Enter replacement text" HBox.hgrow="ALWAYS"/>
    </HBox>

    <HBox spacing="10">
        <Button fx:id="processFilesButton" text="Process Files" onAction="#handleProcessFiles" />
        <Button fx:id="saveResultsButton" text="Save Results" onAction="#handleSaveResults" />
    </HBox>

    <Label text="Processing Results:"/>
    <TextArea fx:id="resultTextArea" prefHeight="200.0" promptText="Processing results will appear here" VBox.vgrow="ALWAYS"/>
</VBox>