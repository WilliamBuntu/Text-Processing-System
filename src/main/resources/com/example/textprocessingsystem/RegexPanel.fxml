<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.TextArea?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.textprocessingsystem.controller.RegexPanelController"
            prefWidth="800" prefHeight="500">

    <left>
        <VBox spacing="7">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <Label text="Input Text:"/>
            <TextArea fx:id="inputTextArea" prefHeight="200" VBox.vgrow="ALWAYS"/>

            <Label text="Results:"/>
            <TextArea fx:id="resultTextArea" prefHeight="200" editable="false" VBox.vgrow="ALWAYS"/>
        </VBox>
    </left>

    <center>
        <Separator orientation="VERTICAL"/>
    </center>

    <right>
        <VBox spacing="15" prefWidth="300">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <Label text="Controls:"/>

            <Label text="Regular Expression:"/>
            <TextField fx:id="regexField"/>

            <Label text="Replacement Text:"/>
            <TextField fx:id="replacementField"/>

            <VBox spacing="5">
                <Button fx:id="searchButton" text="Search" onAction="#handleSearch" maxWidth="Infinity"/>
                <Button fx:id="replaceButton" text="Replace" onAction="#handleReplace" maxWidth="Infinity"/>
                <Button fx:id="replaceFirstButton" text="Replace First" onAction="#handleReplaceFirst" maxWidth="Infinity"/>
                <Button fx:id="splitButton" text="Split" onAction="#handleSplit" maxWidth="Infinity"/>
                <Button fx:id="matchesButton" text="Matches" onAction="#handleMatches" maxWidth="Infinity"/>
                <Separator/>
                <Button fx:id="loadFileButton" text="Load File" onAction="#handleLoadFile" maxWidth="Infinity"/>
                <Button fx:id="saveFileButton" text="Save Results" onAction="#handleSaveFile" maxWidth="Infinity"/>
            </VBox>
        </VBox>
    </right>

</BorderPane>