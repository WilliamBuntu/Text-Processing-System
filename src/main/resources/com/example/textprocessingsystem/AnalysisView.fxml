<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.textprocessingsystem.controller.AnalysisViewController"
      spacing="10">
    <padding>
        <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
    </padding>

    <Label text="Text Analysis" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>

    <Label text="Input Text:"/>
    <TextArea fx:id="inputTextArea" prefHeight="200.0" promptText="Enter text for analysis"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Pattern:" />
        <TextField fx:id="patternField" promptText="Optional pattern for analysis" HBox.hgrow="ALWAYS"/>
    </HBox>

    <HBox spacing="10">
        <Button fx:id="analyzeWordFrequencyButton" text="Analyze Word Frequency" onAction="#handleAnalyzeWordFrequency" />
        <Button fx:id="analyzePatternFrequencyButton" text="Analyze Pattern Frequency" onAction="#handleAnalyzePatternFrequency" />
        <Button fx:id="generateSummaryButton" text="Generate Summary" onAction="#handleGenerateSummary" />
<!--        <Button fx:id="loadFileButton" text="Load File" onAction="#handleLoadFile"/>-->
<!--        <Button fx:id="saveResultsButton" text="Save Results" onAction="#handleSaveResults"/>-->
        <Button fx:id="analyzeCharacterDistributionButton" text="Character Distribution" onAction="#analyzeCharacterDistribution"/>

    </HBox>

    <Label text="Analysis Results:"/>
    <TextArea fx:id="resultTextArea" prefHeight="200.0" promptText="Results will appear here" editable="false"/>
</VBox>