<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.control.Label?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.textprocessingsystem.controller.MainController"
            prefHeight="700.0" prefWidth="900.0">
    <padding>
        <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
    </padding>

    <center>
        <TabPane fx:id="tabPane">
            <Tab text="Text Operations" closable="false">
                <fx:include source="RegexPanel.fxml" />
            </Tab>
            <Tab text="Data Analysis" closable="false">
                <fx:include source="AnalysisView.fxml" />
            </Tab>
            <Tab text="Batch Processing" closable="false">
                <fx:include source="BatchProcessing.fxml" />
            </Tab>
        </TabPane>
    </center>

    <bottom>
        <Label fx:id="statusLabel" text="Ready">
            <padding>
                <Insets top="5.0"/>
            </padding>
        </Label>
    </bottom>
</BorderPane>